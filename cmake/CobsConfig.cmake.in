@PACKAGE_INIT@

# ==============================================================================
# cobs CMake Package Configuration File
# ==============================================================================

# ==============================================================================
# Dependencies
# ==============================================================================
include(CMakeFindDependencyMacro)

# List dependencies here. Example:
# find_dependency(Threads)

# ==============================================================================
# Component Support
# ==============================================================================
# (Optional: Only keep this if you actually separate your library into 
#  distinct targets like Cobs::Core and Cobs::Utils)

set(_Cobs_supported_components Runtime Development)

foreach(_comp ${Cobs_FIND_COMPONENTS})
    if(NOT _comp IN_LIST _Cobs_supported_components)
        set(Cobs_FOUND False)
        set(Cobs_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
    endif()
endforeach()

# ==============================================================================
# Import Targets
# ==============================================================================
if(NOT TARGET Cobs::Cobs)
    include("${CMAKE_CURRENT_LIST_DIR}/CobsTargets.cmake")
endif()

# ==============================================================================
# Package Variables (Legacy Support)
# ==============================================================================

# 1. Main Library Variable
set(Cobs_LIBRARIES Cobs::Cobs)

# 2. Include Dirs (Using set_and_check for safety)
#    Requires PATH_VARS CMAKE_INSTALL_INCLUDEDIR in CMakeLists.txt
set_and_check(Cobs_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# ==============================================================================
# Finalization
# ==============================================================================
check_required_components(Cobs)